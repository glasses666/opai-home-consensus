<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=1600, height=900">
  <title>OPAI · 中央留白 — 小样 02</title>
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
  <style>
    @font-face { font-family: Didot; src: local('Didot Bold'); font-weight: 700; }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { width: 1600px; height: 900px; overflow: hidden; background: #F3F0E9; }
    #root { width: 1600px; height: 900px; overflow: hidden; background: #F3F0E9; }
    .scene-content { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; }
    .assembly { width: 480px; height: 150px; position: relative; }
    .word { width: 100%; height: 100%; display: flex; justify-content: center; align-items: center; gap: 1px; }
    .letter { width: 117.5px; height: 150px; position: relative; }
    .glyph { position: absolute; inset: 0; display: flex; justify-content: center; align-items: center; font-family: Didot, serif; font-weight: 700; font-size: 139px; line-height: 1; letter-spacing: -.035em; color: #39372F; transform-origin: 50% 90%; }
  </style>
</head>
<body>
  <div data-hf-id="hf-db3j" id="root" data-composition-id="opai-preloader" data-start="0" data-duration="5" data-width="1600" data-height="900">
    <div data-hf-id="hf-cn5c" class="scene-content">
      <div data-hf-id="hf-r0zb" class="assembly" aria-label="OPAI" data-layout-allow-overflow="">
        <div data-hf-id="hf-241r" class="word" id="word" aria-hidden="true"></div>
      </div>
    </div>
  </div>
  <script>
    const word = document.getElementById('word');
    for (const [column, character] of [...'OPAI'].entries()) {
      const letter = document.createElement('div'); letter.className = 'letter';
      for (let row = 0; row < 7; row++) {
        const slice = document.createElement('span');
        slice.className = 'glyph'; slice.textContent = character;
        slice.setAttribute('data-layout-allow-overlap', '');
        slice.dataset.column = column; slice.dataset.row = row;
        slice.style.clipPath = `inset(${Math.max(0, row * 100 / 7 - .12)}% 0 ${Math.max(0, 100 - (row + 1) * 100 / 7 - .12)}% 0)`;
        letter.append(slice);
      }
      word.append(letter);
    }
    const tl = gsap.timeline({ paused: true });
    document.querySelectorAll('.glyph').forEach(slice => {
      const column = Number(slice.dataset.column), level = 6 - Number(slice.dataset.row);
      tl.from(slice, {
        y: -30 - level * 12, x: (column - 1.5) * (4.5 + level * 1.5),
        rotation: (column % 2 ? 1 : -1) * .65, opacity: 0,
        duration: .78 + level * .055,
        ease: ['power2.out', 'power3.out', 'sine.out'][column % 3]
      }, .7 + level * .245 + column * .085);
    });
    window.__timelines = window.__timelines || {};
    window.__timelines['opai-preloader'] = tl;
  </script>
</body>
</html>
