<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=1600, height=900">
  <title>欧派 · 右轴波浪翻牌 — 小样 04</title>
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body, #root { width: 1600px; height: 900px; overflow: hidden; background: #FFFFFF; }
    .scene-content { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }
    .assembly { width: 384px; height: 120px; display: flex; align-items: center; justify-content: center; }
    .tiles { width: 384px; height: 72px; display: grid; grid-template-columns: repeat(16,24px); grid-template-rows: repeat(3,24px); }
    .cell { width: 24px; height: 24px; position: relative; perspective: 140px; perspective-origin: 100% 50%; }
    .cast-shadow { position: absolute; left: 0; top: 3px; width: 24px; height: 24px; background: rgba(48,39,27,.16); box-shadow: 2px 3px 7px 2px rgba(48,39,27,.18); border-radius: 2px; opacity: 0; transform-origin: 100% 50%; }
    .tile { position: relative; width: 24px; height: 24px; background-color: #FFFFFF; background-image: url('./assets/oppein-official-header.jpg'); background-repeat: no-repeat; background-size: 545.495327px 61.009346px; backface-visibility: hidden; transform-origin: 100% 50%; will-change: transform; }
    .shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(48,39,27,.24), rgba(48,39,27,.02)); opacity: 0; backface-visibility: hidden; }
  </style>
</head>
<body>
  <div data-hf-id="hf-w0se" id="root" class="clip" data-composition-id="opai-preloader" data-start="0" data-duration="16.8" data-width="1600" data-height="900">
    <div data-hf-id="hf-cn5c" class="scene-content">
      <div data-hf-id="hf-zrzn" class="assembly" aria-label="欧派 OPPEIN 官方商标">
        <div data-hf-id="hf-czj5" class="tiles" id="tiles" aria-hidden="true"></div>
      </div>
    </div>
  </div>
  <script>
    // Crop the official header at its 214px brand boundary; do not redraw or stretch the mark.
    const grid = document.getElementById('tiles');
    for (let row = 0; row < 3; row++) {
      for (let column = 0; column < 16; column++) {
        const cell = document.createElement('div'); cell.className = 'cell';
        const shadow = document.createElement('div'); shadow.className = 'cast-shadow';
        const shade = document.createElement('div'); shade.className = 'shade';
        const tile = document.createElement('div'); tile.className = 'tile';
        tile.id = `tile-${row}-${column}`;
        tile.dataset.row = row; tile.dataset.column = column;
        tile.style.backgroundPosition = `${-column * 24}px ${5.495327 - row * 24}px`;
        tile.append(shade); cell.append(shadow, tile); grid.append(cell);
      }
    }
    const tl = gsap.timeline({ paused: true });
    tl.addLabel('blank', 0);
    tl.addLabel('reveal', .15);
    tl.addLabel('hold', 2.25);
    tl.addLabel('exit', 3.15);
    document.querySelectorAll('.tile').forEach(tile => {
      const column = Number(tile.dataset.column), row = Number(tile.dataset.row);
      const shadow = tile.previousElementSibling, shade = tile.firstElementChild;
      // The right edge stays anchored; neighboring columns overlap into one traveling wave.
      for (let cycle = 0; cycle < 3; cycle++) {
        const start = cycle * 5.6, offset = column * .09 + row * .012;
        const enter = start + .15 + offset, leave = start + 3.15 + offset;
        tl.fromTo(tile, { rotationY: 180 }, {
          rotationY: 0, duration: .72, ease: 'sine.inOut', immediateRender: cycle === 0
        }, enter);
        tl.to(tile, { rotationY: -180, duration: .68, ease: 'sine.inOut' }, leave);
        for (const [at, duration] of [[enter, .72], [leave, .68]]) {
          tl.fromTo(shadow, { opacity: 0, x: 0, scaleX: 1 }, {
            opacity: .65, x: 5, scaleX: .5, duration: duration / 2,
            ease: 'sine.out', immediateRender: false
          }, at);
          tl.to(shadow, { opacity: 0, x: 0, scaleX: 1, duration: duration / 2, ease: 'sine.in' }, at + duration / 2);
          tl.fromTo(shade, { opacity: 0 }, {
            opacity: .75, duration: duration / 2, ease: 'sine.out', immediateRender: false
          }, at);
          tl.to(shade, { opacity: 0, duration: duration / 2, ease: 'sine.in' }, at + duration / 2);
        }
        tl.set(tile, { rotationY: 180 }, start + 5.6);
      }
    });
    // Reset only while every face is hidden: the cycle boundary has identical white pixels.
    window.__timelines = window.__timelines || {};
    window.__timelines['opai-preloader'] = tl;
  </script>
</body>
</html>
